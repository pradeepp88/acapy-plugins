##FROM python:3.13-slim-bookworm AS base for testing 
FROM python:3.13-slim-bookworm
WORKDIR /usr/src/app

# Install system dependencies
RUN apt-get update && apt-get install -y curl jq postgresql-client && apt-get clean

# Install Poetry
ENV POETRY_VERSION=2.1.2
ENV POETRY_HOME="/opt/poetry"
ENV POETRY_CACHE_DIR="$POETRY_HOME/.cache"
RUN curl -sSL https://install.python-poetry.org | python3 -
ENV PATH="$POETRY_HOME/bin:$PATH"

# Copy project files
COPY pyproject.toml poetry.lock ./
COPY admin/ admin/
COPY tenant/ tenant/
COPY core/ core/
COPY resources/ resources/
COPY alembic/ alembic/
COPY README.md ./

# Install Python dependencies
RUN poetry install --no-interaction --no-ansi --without dev

# Set environment variable for Alembic DB URL (can be overridden at runtime)
ENV ALEMBIC_DB_URL=""
ENV ALEMBIC_DB_SCHEMA="admin"

# Entrypoint script to initialize DB and run servers
COPY docker/entrypoint_authserver_openshift.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# OpenShift runs the container as a random UID that belongs to group 0 and has
# no passwd entry. Give group 0 the owner's access to everything poetry touches
# at runtime, and point HOME somewhere writable (it would otherwise be /).
ENV HOME=/usr/src/app
RUN chgrp -R 0 /usr/src/app /opt/poetry \
    && chmod -R g=u /usr/src/app /opt/poetry
USER 1001

ENTRYPOINT ["/entrypoint.sh"]